# Helm
*.tgz
chart/charts/
chart/Chart.lock

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Stray downloads that land in the working directory.
# The repo tracks no PDFs; docs/ ships .md, .html, .svg and .png.
*.pdf

# Local credentials / overrides
clouds.yaml
.env
.env.local
*.kubeconfig
*openrc*.sh

# Python bytecode from running scripts/validate.py locally
__pycache__/
*.py[cod]

# Service-account / private key material. A seatbelt, not a boundary: it cannot
# cover a filename you invent, and it does not stop a paste into a values file
# or a bug report. kagent/README.md "Key hygiene" has the rest.
key.json
*service-account*.json
*-sa.json
sa-*.json
*credentials*.json
*.pem
